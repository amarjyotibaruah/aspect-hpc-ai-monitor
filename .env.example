# ASPECT HPC-AI Monitor Configuration
# Copy this file to .env and customize for your environment

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

MONITORING_ENABLED=true
MONITORING_INTERVAL=300
# Monitoring check interval in seconds

# ============================================================================
# PHASE 1: CORE ANALYSIS (ACTIVE)
# ============================================================================

PARSER_STRICT_MODE=false
# Set to true to fail on parsing errors, false to skip

ANALYZER_GMRES_THRESHOLD=500
# Warn if GMRES iterations exceed this

ANALYZER_RESIDUAL_THRESHOLD=1e-2
# Error if residual exceeds this value

REPORT_OUTPUT_DIR=./reports
# Directory for generated reports

# ============================================================================
# PHASE 2: HPC INTEGRATION (PLANNED)
# ============================================================================
# Uncomment and configure when Phase 2 is implemented

# PRIMARY_CLUSTER=cedar
# Cluster to monitor: cedar, niagara, graham, beluga

# CEDAR_HOST=cedar.computecanada.ca
# CEDAR_PORT=22
# CEDAR_USERNAME=your_username
# CEDAR_PRIVATE_KEY=/home/user/.ssh/id_rsa
# CEDAR_WORK_DIR=/scratch/user

# NIAGARA_HOST=niagara.scinet.utoronto.ca
# NIAGARA_PORT=22
# NIAGARA_USERNAME=your_username
# NIAGARA_PRIVATE_KEY=/home/user/.ssh/id_rsa
# NIAGARA_WORK_DIR=/scratch/user

# GRAHAM_HOST=graham.computecanada.ca
# GRAHAM_PORT=22
# GRAHAM_USERNAME=your_username
# GRAHAM_PRIVATE_KEY=/home/user/.ssh/id_rsa
# GRAHAM_WORK_DIR=/scratch/user

# BELUGA_HOST=beluga.computecanada.ca
# BELUGA_PORT=22
# BELUGA_USERNAME=your_username
# BELUGA_PRIVATE_KEY=/home/user/.ssh/id_rsa
# BELUGA_WORK_DIR=/scratch/user

# LOG_REMOTE_PATHS=simulation_*.log,aspect_*.log
# Comma-separated patterns for remote log files

# ============================================================================
# PHASE 3: AI INTEGRATION (PLANNED)
# ============================================================================
# Uncomment and configure when Phase 3 is implemented

# AI_PROVIDER=openai
# Options: openai, azure_openai

# OPENAI_API_KEY=sk-...
# Get from: https://platform.openai.com/api-keys

# OPENAI_MODEL=gpt-4
# Model to use: gpt-4, gpt-3.5-turbo

# OPENAI_MAX_TOKENS=2000
# Maximum tokens per request

# AZURE_OPENAI_API_KEY=...
# Get from Azure portal

# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# Azure OpenAI endpoint URL

# AZURE_OPENAI_DEPLOYMENT=gpt-4
# Deployment name in Azure

# AI_CACHE_ENABLED=true
# Cache AI analysis results to save costs

# AI_COST_LIMIT_PER_RUN=0.50
# Maximum cost per simulation analysis (USD)

# ============================================================================
# DATABASE CONFIGURATION (PHASE 3)
# ============================================================================
# Uncomment when Phase 3 is implemented

# DATABASE_DIALECT=sqlite
# Options: sqlite, postgresql

# SQLITE_DATABASE_PATH=./aspect_monitor.db
# Path to SQLite database file

# POSTGRESQL_HOST=localhost
# POSTGRESQL_PORT=5432
# POSTGRESQL_USER=postgres
# POSTGRESQL_PASSWORD=password
# POSTGRESQL_DATABASE=aspect_monitor

# DATABASE_ECHO=false
# Log all SQL queries (debug)

# DATABASE_POOL_SIZE=5
# Connection pool size for PostgreSQL

# ============================================================================
# PHASE 4: NOTIFICATIONS (PLANNED)
# ============================================================================
# Uncomment when Phase 4 is implemented

# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Slack webhook URL for notifications

# EMAIL_ENABLED=false
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_FROM_ADDRESS=your_email@gmail.com
# EMAIL_PASSWORD=app_password
# EMAIL_TO_ADDRESSES=colleague@example.com,supervisor@example.com

# NOTIFY_ON_CRITICAL=true
# NOTIFY_ON_ERROR=true
# NOTIFY_ON_WARNING=false

# ============================================================================
# GITHUB INTEGRATION (PHASE 4)
# ============================================================================
# Uncomment when Phase 4 is implemented

# GITHUB_TOKEN=ghp_...
# GitHub personal access token

# GITHUB_REPO_OWNER=amarjyotibaruah
# GITHUB_REPO_NAME=aspect-hpc-ai-monitor
# Repository for issue creation

# AUTO_CREATE_GITHUB_ISSUES=false
# Automatically create GitHub issues for critical failures

# ============================================================================
# DEVELOPMENT / DEBUG
# ============================================================================

DEBUG_MODE=false
DEBUG_DUMP_PARSED_LOG=false
# Dump parsed log structure to file

DEBUG_KEEP_TEMP_FILES=false
# Keep temporary files for inspection
